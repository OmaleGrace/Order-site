
DATABASE_URL=postgres://user:password@localhost:5432/laikihub?sslmode=disable
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:8080/payment/callback
APP_BASE_URL=http://localhost:8080
PORT=8080
TRUSTED_PROXY_COUNT=1
MAIN_ADMIN_EMAIL=
BUSINESS_NAME=

# Anyone who opens an old address sees a short "we have rebranded" page and is sent to the same page
# on the new address. Payment callbacks keep working on the old address, so payments in progress are safe.
LEGACY_HOSTS=
# The new address, no trailing slash. Default https://laikihub.onrender.com
CANONICAL_BASE_URL=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
TERMII_API_KEY=
TERMII_SENDER_ID=
VENDOR_ORDER_SMS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

ADSENSE_PUBLISHER_ID=

# Signs the order-tracking links guests receive. Use a long random value, for example the output
# of: openssl rand -hex 32. If empty, PAYSTACK_SECRET_KEY is used instead. Changing it breaks
# tracking links that were already sent.
ORDER_TRACKING_SECRET=


# Service fee added to every customer order. Default 0 (no fee).
SERVICE_FEE_KOBO=
# Share of each order kept by the platform, 0 to 50. Default 10.
VENDOR_COMMISSION_PERCENT=
# Same, for shops on the Pro plan. Default 5.
PRO_COMMISSION_PERCENT=
# Free trial days for new shops. Default 0.
VENDOR_TRIAL_DAYS=
# One-off fee to open a shop. Default 500000 (N5,000).
VENDOR_SETUP_FEE_KOBO=
# Pro plan price for 30 days. Default 500000 (N5,000).
PRO_PLAN_PRICE_KOBO=
# Promoting a shop for 7 days. Default 300000 (N3,000).
PROMOTION_WEEK_PRICE_KOBO=
# Customer Pass price. Default 100000 (N1,000).
PASS_PRICE_KOBO=
# Hours a shop's earnings are held before payout, 0 to 720. Default 24.
PAYOUT_HOLD_HOURS=
# Points a customer gets for a successful referral. Default 300.
REFERRAL_BONUS_POINTS=
# Food total a friend's first order must reach before the referral bonus is paid. Default 150000 (N1,500).
REFERRAL_MIN_ORDER_KOBO=

# ---------------------------------------------------------------------------
# Developing and testing
# ---------------------------------------------------------------------------

# Read page templates from disk so edits show on refresh:  TEMPLATES_DIR=templates go run .
TEMPLATES_DIR=
# Database for the tests that need a real PostgreSQL. If empty, the tests use
# postgresql://testuser:testpass@localhost:5433/food_ordering_test. For safety they refuse any
# database that is not on localhost or whose name does not end in _test.
TEST_DATABASE_URL=
