# Copy this file to .env and fill in values from your hosting/database dashboards.
# Never commit the real .env file.
PORT=8080
BUSINESS_NAME=ENIE
MAIN_ADMIN_EMAIL=omalegrace2009@gmail.com
APP_BASE_URL=http://localhost:8080
# Public absolute URL used for images in transactional emails (set to your live domain in production).
PUBLIC_BASE_URL=http://localhost:8080

# PostgreSQL connection URL. Use the external connection URL from your hosted
# PostgreSQL provider when running this app on your own computer.
DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Payments (use test keys during development)
# Required for Nigerian vendor bank-account verification via Paystack; keep secret.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:8080/payment/callback

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Optional transactional email and SMS services
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
TERMII_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI writing assistant. OpenAI is used when OPENAI_API_KEY is set;
# otherwise the app can use Gemini when GEMINI_API_KEY is set.
# Keep provider keys private; never expose them in browser JavaScript.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional platform fees (leave defaults in code unless you intend to change them)
VENDOR_COMMISSION_PERCENT=10
